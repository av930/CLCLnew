{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Kill CPCP.exe",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "taskkill /F /IM CPCP.exe >nul 2>&1 & exit 0"
      ],
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "Build CPCP (Release x86)",
      "type": "process",
      "command": "C:\\Program Files\\Microsoft Visual Studio\\2022\\BuildTools\\MSBuild\\Current\\Bin\\MSBuild.exe",
      "args": [
        "CPCP.sln",
        "/p:Configuration=Release",
        "/p:Platform=x86",
        "/m"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Kill CPCP.exe",
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run CPCP (Release x86)",
      "type": "shell",
      "command": "Start-Process",
      "args": [
        "-FilePath",
        "${workspaceFolder}\\Release\\CPCP.exe",
        "-WorkingDirectory",
        "${workspaceFolder}\\Release"
      ],
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "Build & Run CPCP (Release x86)",
      "type": "shell",
      "command": "echo",
      "args": [
        "Build & Run complete"
      ],
      "dependsOn": [
        "Build CPCP (Release x86)",
        "Run CPCP (Release x86)"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": false
      }
    }
  ]
}
